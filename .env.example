DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# D5：LLM 客户端（live 测试；详见 README 与 docs/adr/0008）
LLM_BACKEND=openai
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_STRUCTURED_MODE=auto
# 通用 provider 参数（JSON；经 SDK extra_body 透传；切回 OpenAI 置空即可）
# DeepSeek 生产推荐（本机探测结论 2026-10-05）：禁用思考档位 → reasoning_tokens 趋零、content 稳定非空。
# 合法值：thinking.type ∈ {enabled, disabled}（默认 enabled）；reasoning_effort ∈ {none, low, high, max}
#   （none 禁用思考；为兼容 minimal→low、medium/xhigh→high）；thinking 与 reasoning_effort 二选一即可。
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
VECTOR_STORE=chroma
CHROMA_DIR=.data/chroma
# 只读 Git 仓库白名单（sync_git_repo 用；os.pathsep 分隔，相对 BASE_DIR 解析）
# Windows 用分号 ";"（如 .data;D:\repos\demo）；Linux/macOS 用冒号 ":"
GIT_READONLY_ROOTS=.data
GIT_ALLOW_WRITE=0