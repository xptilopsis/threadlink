DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
VECTOR_STORE=chroma
CHROMA_DIR=.data/chroma
# 只读 Git 仓库白名单（sync_git_repo 用；os.pathsep 分隔，相对 BASE_DIR 解析）
# Windows 用分号 ";"（如 .data;D:\repos\demo）；Linux/macOS 用冒号 ":"
GIT_READONLY_ROOTS=.data
GIT_ALLOW_WRITE=0